        "max=lambda a,b:a if (a>b) else b\n",
        "print(max(4,5))\n",
        "x=lambda a:a+1\n",
        "print(x(5))\n",
        "x=lambda a,b,c:a+b+c\n",
        "print(x(5,6,2))\n"
