    {
      "cell_type": "code",
      "source": [
        "def oddeven(x):\n",
        "  if x%2==0:\n",
        "    return True\n",
        "  else:\n",
        "    return False\n",
        "list1=[4,5,6,7,8,9]\n",
        "evenlist=list(filter(oddeven,list1))\n",
        "print(evenlist)"
      ],
